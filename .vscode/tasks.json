{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chay Trong RAM (Khong tao .class)",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "dist/*;dist/libs/*;.",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
